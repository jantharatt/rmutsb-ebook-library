# ป้องกันกรณีวางโปรเจกต์ไว้ใน htdocs (XAMPP) แล้วเปิดผ่านโฟลเดอร์ราก
# - ห้ามเข้าถึงไฟล์ตั้งค่า/ไฟล์ระบบ (.env, env.php, composer.*, storage, vendor ฯลฯ)
# - ส่งทุกคำขอไปยังโฟลเดอร์ public/
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(\.env|env\.php|\.git|composer\.(json|lock)|package(-lock)?\.json|artisan|phpunit\.xml|docker|storage|vendor|database|config|app|bootstrap|routes|resources|tests|node_modules)(/.*)?$ - [F,L,NC]
    RewriteRule ^(?!public/)(.*)$ public/$1 [L]
</IfModule>

<FilesMatch "^(\.env.*|env\.php)$">
    Require all denied
</FilesMatch>
