# Copy to docker/.env before running `docker compose up`.
# Read automatically by Docker Compose because it lives next to docker-compose.yml.

# Host ports (only these are published outside the "backend" network)
APP_PORT=8080
PMA_PORT=8081

# MariaDB (container-internal port only — never published to the host)
DB_PORT=3308
DB_DATABASE=ebook_system
DB_USERNAME=laravel
DB_PASSWORD=laravel_secret
DB_ROOT_PASSWORD=root_secret
